{
  "manifest_version": 3,
  "name": "【隔离测试】谛听百应采集",
  "version": "0.5.9",
  "version_name": "WR-P-009-AUTO-SETTINGS-TEST-20260922",
  "description": "从已登录的百应页面汇总直播数据，并通过本机桥接程序提交飞书。",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://compass.jinritemai.com/*",
    "https://holiday.dreace.top/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://compass.jinritemai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "「谛听」百应场控数据采集",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
