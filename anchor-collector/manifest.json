{
  "manifest_version": 3,
  "name": "谛听 · 抖音主播取数测试",
  "version": "0.4.4",
  "description": "每10秒采集主播指标，每5分钟上传；连续10分钟无新采样自动补传，浏览器重启后补传缓存。",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://anchor.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://anchor.douyin.com/*"
      ],
      "js": [
        "content.js",
        "source-control.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://live-ansys.ai.lab.yc345.tv/*"
      ],
      "js": [
        "review-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*"
  ]
}
