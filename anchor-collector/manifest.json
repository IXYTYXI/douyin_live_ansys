{
  "manifest_version": 3,
  "name": "谛听 · 抖音主播取数测试",
  "version": "0.3.0",
  "description": "每10秒采集主播指标，本地暂存，每5分钟批量上传到配置的后端。",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://anchor.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://anchor.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*"
  ]
}
